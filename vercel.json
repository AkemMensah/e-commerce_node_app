{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/docs/(.*)",
      "destination": "/api/docs/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.js"
    },
    {
      "source": "/api-docs/swagger-ui.css",
      "destination": "/node_modules/swagger-ui-dist/swagger-ui.css"
    },
    {
      "source": "/api-docs/swagger-ui-bundle.js",
      "destination": "/node_modules/swagger-ui-dist/swagger-ui-bundle.js"
    },
    {
      "source": "/api-docs/swagger-ui-standalone-preset.js",
      "destination": "/node_modules/swagger-ui-dist/swagger-ui-standalone-preset.js"
    }
  ]
}
